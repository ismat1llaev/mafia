# === Обязательные ===

# Токен бота от @BotFather
BOT_TOKEN=123456789:AAaaBBbbCCccDDddEEeeFFffGGgg

# Публичный HTTPS-адрес приложения (без слэша в конце).
# На Render задавать НЕ нужно: он сам отдаёт RENDER_EXTERNAL_URL, а сервер
# её подхватывает. Переменная нужна только для локального запуска или если
# у приложения свой домен.
PUBLIC_URL=http://localhost:3000

# === Необязательные ===

# Юзернейм бота без @ — используется для ссылок-приглашений
BOT_USERNAME=MafiaGameGGbot

# Порт (Render подставляет свой автоматически)
PORT=3000

# Канал проекта. Кнопка «Подписаться на канал» появляется в игре только
# когда эта переменная задана. Можно писать как угодно:
#   MafiaNews   |   @MafiaNews   |   https://t.me/MafiaNews
CHANNEL_URL=

# === Автопубликация постов в канал ===
#
# Куда публиковать. Для публичного канала — @имя, для приватного — числовой
# id вида -1001234567890. Если канал публичный и CHANNEL_URL уже задан,
# эту переменную можно не заполнять: имя возьмётся оттуда.
#
# Бота нужно сделать администратором канала с правом публикации сообщений.
# Без CHANNEL_ID автопубликация просто выключена.
CHANNEL_ID=

# Отдельный бот для канала — необязательно.
# Если задать сюда токен второго бота, посты будут выходить от его имени,
# и команды /kanal, /postnow и прочие переедут к нему. Игровой бот при этом
# занимается только игрой. Оставьте пустым — каналом займётся игровой бот.
CHANNEL_BOT_TOKEN=

# Раз в сколько дней выходит пост
POST_EVERY_DAYS=2

# В каком часу публиковать, по UTC. Самара — UTC+4, поэтому 8 = полдень.
POST_HOUR_UTC=8

# Куда класть файл базы со статистикой.
# На бесплатном плане Render диска нет, и файл обнуляется при перезапуске.
# Чтобы статистика жила, нужен платный план с Disk и DB_PATH=/data/stats.json
DB_PATH=./data/stats.json

# Режим работы бота: webhook (для продакшена) или polling (для локальной разработки)
BOT_MODE=webhook

# Секрет для проверки вебхука — придумай любую случайную строку
WEBHOOK_SECRET=change-me-to-random-string

# Разрешить вход без Telegram — режим отладки.
# Открывает игру по адресу вида PUBLIC_URL/?dev=1, где каждая цифра даёт
# отдельного игрока. Удобно тестировать партию в одиночку в нескольких
# вкладках браузера.
# ОБЯЗАТЕЛЬНО выключайте обратно после тестов: пока он включён, войти
# в игру может любой, кто знает адрес.
ALLOW_DEV_AUTH=false

# Сколько всего игроков за столом в режиме «Играть с ботами»:
# вы и боты в придачу. Допустимо от 5 до 12, по умолчанию 7 —
# при семерых в игре две мафии, доктор и комиссар.
SOLO_PLAYERS=7
